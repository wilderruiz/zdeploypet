<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        PDA-8 V1 theme foundation.

        These resources intentionally do not replace the application's existing implicit
        styles yet. Later visual phases opt owning surfaces into the named Pda8* styles,
        allowing the redesign to land incrementally without changing deployment behavior.
    -->

    <!-- Accepted v2 palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080A0D" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#11151B" />
    <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#161B22" />
    <SolidColorBrush x:Key="AppConsoleBrush" Color="#07090C" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#262C35" />
    <SolidColorBrush x:Key="AppBorderStrongBrush" Color="#343C47" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#F4F1EA" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#8E97A5" />

    <!-- Warm brand accents are deliberately restrained. -->
    <SolidColorBrush x:Key="AppBrandAccentBrush" Color="#C9A46A" />
    <SolidColorBrush x:Key="AppBrandAccentHoverBrush" Color="#DFC087" />
    <SolidColorBrush x:Key="AppBrandRedBrush" Color="#D48B68" />

    <!-- Semantic workspace identities. -->
    <SolidColorBrush x:Key="AppDryBrush" Color="#172332" />
    <SolidColorBrush x:Key="AppDryBorderBrush" Color="#34475B" />
    <SolidColorBrush x:Key="AppDryTextBrush" Color="#D8E8F7" />
    <SolidColorBrush x:Key="AppLiveBrush" Color="#14291F" />
    <SolidColorBrush x:Key="AppLiveBorderBrush" Color="#345E49" />
    <SolidColorBrush x:Key="AppLiveTextBrush" Color="#D9F5E5" />
    <SolidColorBrush x:Key="AppReportsBrush" Color="#282131" />
    <SolidColorBrush x:Key="AppReportsBorderBrush" Color="#554967" />
    <SolidColorBrush x:Key="AppReportsTextBrush" Color="#EADFF4" />

    <!-- Semantic state colors. -->
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#64D89A" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#C9A46A" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#D46A72" />
    <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#687383" />
    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="#0A0F14" />
    <SolidColorBrush x:Key="AppInputHoverBrush" Color="#10161D" />
    <SolidColorBrush x:Key="AppSelectionBrush" Color="#213149" />

    <!-- Reusable metrics. -->
    <CornerRadius x:Key="Pda8RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="Pda8RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="Pda8RadiusLarge">16</CornerRadius>
    <Thickness x:Key="Pda8CardPadding">16</Thickness>
    <Thickness x:Key="Pda8CompactPadding">10,7</Thickness>
    <Thickness x:Key="Pda8InputPadding">10,7</Thickness>
    <sys:Double x:Key="Pda8CompactControlHeight">32</sys:Double>
    <sys:Double x:Key="Pda8ToolbarIconSize">34</sys:Double>

    <!-- Standard card/panel. -->
    <Style x:Key="Pda8CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Pda8RadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource Pda8CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Raised card for workflow sections. -->
    <Style x:Key="Pda8RaisedCardStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource Pda8CardStyle}">
        <Setter Property="Background" Value="{StaticResource AppSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
    </Style>

    <!-- Shared native button grammar. -->
    <Style x:Key="Pda8ButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="Background" Value="{StaticResource AppSurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="{StaticResource Pda8CompactControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Pda8RadiusSmall}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1A2028" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AppBrandAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#202730" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="#10141A" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AppDisabledTextBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact icon-only toolbar action. -->
    <Style x:Key="Pda8IconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Pda8ButtonStyle}">
        <Setter Property="Width" Value="{StaticResource Pda8ToolbarIconSize}" />
        <Setter Property="Height" Value="{StaticResource Pda8ToolbarIconSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
    </Style>

    <!-- Small information button. -->
    <Style x:Key="Pda8InfoButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Pda8IconButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Content" Value="i" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        <Setter Property="ToolTipService.ShowDuration" Value="2147483647" />
    </Style>

    <!-- Segmented DRY/LIVE/REPORTS workspace tab base. -->
    <Style x:Key="Pda8SegmentedTabStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Pda8ButtonStyle}">
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Pda8DryTabStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Pda8SegmentedTabStyle}">
        <Setter Property="Background" Value="{StaticResource AppDryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppDryBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppDryTextBrush}" />
    </Style>

    <Style x:Key="Pda8LiveTabStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Pda8SegmentedTabStyle}">
        <Setter Property="Background" Value="{StaticResource AppLiveBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppLiveBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppLiveTextBrush}" />
    </Style>

    <Style x:Key="Pda8ReportsTabStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Pda8SegmentedTabStyle}">
        <Setter Property="Background" Value="{StaticResource AppReportsBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppReportsBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppReportsTextBrush}" />
    </Style>

    <!-- Compact right-pane channel tab. -->
    <Style x:Key="Pda8ConsoleTabStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource Pda8ButtonStyle}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Text input surface. -->
    <Style x:Key="Pda8TextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="Background" Value="{StaticResource AppInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Pda8InputPadding}" />
        <Setter Property="CaretBrush" Value="{StaticResource AppTextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{StaticResource AppInputHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppBrandAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource AppDisabledTextBrush}" />
                <Setter Property="Opacity" Value="0.82" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Self-contained ComboBox style so opting in never falls back to light OS chrome. -->
    <Style x:Key="Pda8ComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="Background" Value="{StaticResource AppInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7,30,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Pda8RadiusSmall}">
                            <Grid>
                                <ContentPresenter x:Name="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False" />
                                <TextBox x:Name="PART_EditableTextBox"
                                         Margin="6,3,30,3"
                                         Padding="4,2"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{TemplateBinding Foreground}"
                                         SelectionBrush="{StaticResource AppSelectionBrush}"
                                         VerticalContentAlignment="Center"
                                         Visibility="Hidden" />
                                <ToggleButton x:Name="DropDownToggle"
                                              Width="30"
                                              HorizontalAlignment="Right"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent">
                                                <Path Width="8"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Fill="{StaticResource AppMutedTextBrush}"
                                                      Data="M 0 0 L 8 0 L 4 5 Z" />
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="320"
                                    Background="{StaticResource AppInputBackgroundBrush}"
                                    BorderBrush="{StaticResource AppBorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Pda8RadiusSmall}">
                                <ScrollViewer CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="SelectedContent" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource AppInputHoverBrush}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource AppBorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource AppInputHoverBrush}" />
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource AppBrandAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OuterBorder" Property="Background" Value="#10141A" />
                            <Setter Property="Foreground" Value="{StaticResource AppDisabledTextBrush}" />
                            <Setter Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pda8ComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="Background" Value="{StaticResource AppInputBackgroundBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="#1A2028" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource AppDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One tooltip treatment for later phases. -->
    <Style x:Key="Pda8ToolTipStyle" TargetType="{x:Type ToolTip}">
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="#171C23"
                            BorderBrush="{StaticResource AppBorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Pda8RadiusSmall}"
                            Padding="12"
                            TextElement.Foreground="{StaticResource AppTextBrush}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>