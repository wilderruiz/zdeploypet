<Window x:Class="ZDeployPet.App.AccessOnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deployment access — ZDeployPet" Height="700" Width="940" MinHeight="610" MinWidth="820"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Deployment access identity" />
            <TextBlock x:Name="ProfileText" Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="12" Background="#FFF5E6" BorderBrush="#E6C77A" BorderThickness="1">
            <TextBlock TextWrapping="Wrap"
                       Text="PDA-1 verifies SSH identity and authenticated reachability. Dedicated deployment keys stay local in WSL; only the public half may be installed on a target. Public-key installation changes only SSH authorization metadata, not deployment files." />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="1 — Dedicated deployment key" Padding="12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="Use an existing dedicated SSH public key, or let ZDeployPet create one for this profile inside WSL ~/.ssh. Unrelated personal/tunnel keys should not be reused." />
                    <ComboBox x:Name="KeyComboBox" Margin="0,10,0,6" Padding="6" DisplayMemberPath="DisplayName" />
                    <WrapPanel>
                        <Button x:Name="RefreshKeysButton" Padding="12,6" Margin="0,0,8,6" Click="RefreshKeys_Click" Content="Refresh keys" />
                        <Button x:Name="CreateKeyButton" Padding="12,6" Margin="0,0,6,6" Click="CreateKey_Click" Content="Create ZDeployPet key" />
                        <Button x:Name="CreateKeyHelpButton" Style="{StaticResource SharedInfoButtonStyle}" Margin="0,0,8,6" Loaded="CreateKeyHelpButton_Loaded" />
                        <Button x:Name="UseKeyButton" Padding="12,6" Margin="0,0,0,6" Click="UseKey_Click" Content="Use selected key" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,3" FontWeight="SemiBold" Text="Approved fingerprint" />
                    <TextBlock x:Name="ApprovedKeyFingerprintText" TextWrapping="Wrap" FontFamily="Consolas" Text="Not selected" />
                    <TextBlock Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap"
                               Text="If the key fingerprint later changes, probes fail closed until you explicitly approve the key again." />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="2 — Server host identity and key installation" Padding="12">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="Select a configured server, scan and independently verify its SSH host fingerprint, enroll that identity, then install only the approved ZDeployPet public key." />
                    <ComboBox x:Name="TargetComboBox" Margin="0,10,0,6" Padding="6" DisplayMemberPath="Label" SelectionChanged="TargetComboBox_SelectionChanged" />
                    <TextBlock x:Name="TargetEndpointText" Margin="0,0,0,8" Foreground="#555" />
                    <TextBlock FontWeight="SemiBold" Text="Enrolled fingerprint" />
                    <TextBlock x:Name="EnrolledHostFingerprintText" Margin="0,3,0,8" TextWrapping="Wrap" FontFamily="Consolas" Text="Not enrolled" />
                    <WrapPanel>
                        <Button x:Name="ScanHostButton" Padding="12,6" Margin="0,0,6,6" Click="ScanHost_Click" Content="Scan host key" />
                        <Button Style="{StaticResource SharedInfoButtonStyle}" Margin="0,0,8,6"
                                Loaded="ScanHostHelpButton_Loaded" />
                        <Button x:Name="EnrollHostButton" Padding="12,6" Margin="0,0,6,6" Click="EnrollHost_Click" Content="Enroll scanned key" IsEnabled="False" />
                        <Button Style="{StaticResource SharedInfoButtonStyle}" Margin="0,0,8,6"
                                Loaded="EnrollHostHelpButton_Loaded" />
                        <Button x:Name="InstallKeyButton" Padding="12,6" Margin="0,0,6,6" Click="InstallKey_Click" Content="Install public key" />
                        <Button x:Name="InstallKeyHelpButton" Style="{StaticResource SharedInfoButtonStyle}" Margin="0,0,0,6"
                                Loaded="InstallKeyHelpButton_Loaded" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,3" FontWeight="SemiBold" Text="Scanned fingerprint" />
                    <TextBlock x:Name="ScannedHostFingerprintText" TextWrapping="Wrap" FontFamily="Consolas" Text="Not scanned" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="3" Margin="0,14,0,0" Header="3 — Non-writing authenticated probe" Padding="12">
            <DockPanel LastChildFill="True">
                <Button x:Name="ProbeButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,10"
                        Click="Probe_Click" Content="Probe selected target" />
                <TextBox x:Name="ResultTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" Padding="10" Text="Choose a deployment key and enroll a server host fingerprint before probing." />
            </DockPanel>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" DockPanel.Dock="Left" />
            <Button DockPanel.Dock="Right" Padding="16,8" Click="Close_Click" Content="Close" />
        </DockPanel>
    </Grid>
</Window>
