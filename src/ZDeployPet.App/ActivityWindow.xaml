<Window x:Class="ZDeployPet.App.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console / Activity — ZDeployPet"
        Width="980" Height="620"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Console / Activity" />
            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource AppMutedTextBrush}" TextWrapping="Wrap"
                       Text="Sanitized ZDeployPet lifecycle, profile, session and probe events. Secret-bearing values are redacted before entries reach this view." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,14" Padding="12" Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="Bold" Text="Profile" />
                <TextBlock x:Name="ProfileText" Grid.Column="1" Margin="8,0,24,0" Text="—" />
                <TextBlock Grid.Column="2" FontWeight="Bold" Text="Session" />
                <TextBlock x:Name="SessionText" Grid.Column="3" Margin="8,0,0,0" Text="LOCKED" />
            </Grid>
        </Border>

        <ListView x:Name="ActivityList" Grid.Row="2" SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="160" DisplayMemberBinding="{Binding LocalTime}" />
                    <GridViewColumn Header="Level" Width="90" DisplayMemberBinding="{Binding Level}" />
                    <GridViewColumn Header="Category" Width="130" DisplayMemberBinding="{Binding Category}" />
                    <GridViewColumn Header="Message" Width="520" DisplayMemberBinding="{Binding Message}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" />
            <Button x:Name="CopySelectedButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,8"
                    Content="Copy selected" Click="CopySelected_Click" />
            <Button x:Name="CopyAllButton" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,8"
                    Content="Copy all" Click="CopyAll_Click" />
            <Button DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Padding="12,8"
                    Content="Close" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
