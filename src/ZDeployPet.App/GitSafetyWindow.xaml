<Window x:Class="ZDeployPet.App.GitSafetyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git safety — ZDeployPet" Height="610" Width="860" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Repository Git safety" />
            <TextBlock x:Name="ProfileText" Margin="0,6,0,0" Foreground="{StaticResource AppMutedTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="12" Background="{StaticResource AppWarningBackgroundBrush}"
                BorderBrush="{StaticResource AppWarningBorderBrush}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap"
                       Text="ZDeployPet deployment private keys belong only in WSL ~/.ssh, never inside the project repository. This check looks for private-key material in tracked and unignored files and can add a narrow defense-in-depth .gitignore block without changing your existing Git rules." />
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,10">
                <Button x:Name="ScanButton" Padding="14,7" Margin="0,0,8,6" Click="Scan_Click" Content="Scan repository" />
                <Button x:Name="ApplyIgnoreButton" Padding="14,7" Margin="0,0,8,6" Click="ApplyIgnore_Click" Content="Add/update .gitignore safety block" />
            </WrapPanel>
            <TextBox x:Name="ResultTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Padding="12"
                     Text="Repository safety scan has not run." />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource AppMutedTextBrush}" DockPanel.Dock="Left" TextWrapping="Wrap" />
            <Button DockPanel.Dock="Right" Padding="16,8" Click="Close_Click" Content="Close" />
        </DockPanel>
    </Grid>
</Window>
