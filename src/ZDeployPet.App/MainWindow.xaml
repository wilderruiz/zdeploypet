<Window x:Class="ZDeployPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZDeployPet" Height="820" Width="1040" MinHeight="650" MinWidth="860"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="MaxWidth" Value="440" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="20" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.ShowDuration" Value="20000" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="28" FontWeight="SemiBold" Text="ZDeployPet" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,7,0,18" Foreground="#555"
                   Text="Loading local profile…" />

        <ScrollViewer x:Name="SetupPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,14,0">
                <Border Padding="14" Margin="0,0,0,14" Background="#FFF5E6" BorderBrush="#E6C77A" BorderThickness="1">
                    <TextBlock TextWrapping="Wrap" Text="Set up your deployment profile. ZDeployPet will check and save these settings only on this computer. It will not connect to your servers, ask for passwords or deploy anything yet." />
                </Border>

                <GroupBox Header="1 — Choose the project you want to deploy" Padding="12" Margin="0,0,0,12"
                          ToolTip="Identify this deployment profile, select the project folder on Windows, and choose the WSL Linux environment that can access it. ZDeployPet checks the matching Linux path so the deployment script can run from the correct project later.">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Profile name" />
                        <TextBox x:Name="ProfileNameTextBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,4" Padding="7" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Project folder" />
                        <TextBox x:Name="ProjectPathTextBox" Grid.Row="1" Grid.Column="1" Margin="8,4" Padding="7" />
                        <Button Grid.Row="1" Grid.Column="2" Margin="4" Padding="14,7" Click="BrowseProject_Click" Content="Browse…" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Linux environment (WSL)" />
                        <ComboBox x:Name="DistributionComboBox" Grid.Row="2" Grid.Column="1" Margin="8,4" Padding="5" IsEditable="False" />
                        <Button Grid.Row="2" Grid.Column="2" Margin="4" Padding="14,7" Click="RefreshDistributions_Click" Content="Refresh" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Project path in WSL" />
                        <TextBox x:Name="WslPathTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,4" Padding="7" IsReadOnly="True" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="2 — Choose the deployment script and safety settings" Padding="12" Margin="0,0,0,12"
                          ToolTip="Choose the existing deployment script inside your project, where its deployment reports are stored, and the exact phrase required before a live deployment. These settings help ZDeployPet run only the approved script and prevent accidental deployments.">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Deployment script" />
                        <TextBox x:Name="ScriptPathTextBox" Grid.Column="1" Margin="8,4" Padding="7" ToolTip="Example: deploy.sh or scripts/deploy.sh" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Deployment report folder (optional)" />
                        <TextBox x:Name="ReportRootTextBox" Grid.Row="1" Grid.Column="1" Margin="8,4" Padding="7" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Phrase required to deploy" />
                        <TextBox x:Name="ConfirmationTextBox" Grid.Row="2" Grid.Column="1" Margin="8,4" Padding="7" Text="DEPLOY" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="3 — Add the servers that receive your files" Padding="12" Margin="0,0,0,12"
                          ToolTip="List each server used by the deployment, including its friendly name, hostname or IP address, SSH port and username. This section describes connection destinations only; it does not connect, sign in or store a password.">
                    <DataGrid x:Name="TargetsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Server name" Binding="{Binding Label}" Width="140" />
                            <DataGridTextColumn Header="Hostname or IP address" Binding="{Binding Host}" Width="*" />
                            <DataGridTextColumn Header="SSH port" Binding="{Binding Port}" Width="90" />
                            <DataGridTextColumn Header="Username" Binding="{Binding User}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="4 — Choose where each part of the project goes" Padding="12" Margin="0,0,0,12"
                          ToolTip="Map each deployed part—such as a website, private configuration file or backend application—to its server and exact remote folder or file path. A server can have several destinations when different parts must be kept separate.">
                    <StackPanel>
                        <TextBlock Margin="4,0,4,9" TextWrapping="Wrap" Text="Add one row for every remote folder or file. The server name must match a server entered above." />
                        <DataGrid x:Name="DestinationsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Server name" Binding="{Binding TargetLabel}" Width="150" />
                                <DataGridTextColumn Header="What goes here" Binding="{Binding Label}" Width="180" />
                                <DataGridTextColumn Header="Destination folder or file" Binding="{Binding RemotePath}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="5 — Check and save your profile" Padding="12"
                          ToolTip="Check that all local paths, server details and destination mappings are valid, then save the profile on this computer. Saving does not contact a server or deploy anything, and no passwords or private keys are stored in the profile.">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="Your profile is saved only in your Windows Local Application Data folder and is not added to Git. ZDeployPet never stores passwords, key passphrases or private-key contents in this profile." />
                        <TextBlock x:Name="SetupValidationText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#A02020" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="DiscoveryPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Padding="12" Margin="0,0,0,12" Background="#EEF6FF" BorderBrush="#AACCE8" BorderThickness="1">
                <TextBlock x:Name="ProfileSummaryText" TextWrapping="Wrap" />
            </Border>
            <TextBox x:Name="ResultsTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="14"
                     Text="Discovery has not run." />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="EditProfileButton" Margin="0,0,8,0" Padding="16,9" Click="EditProfile_Click" Content="Edit profile" Visibility="Collapsed" />
                <Button x:Name="SaveProfileButton" Padding="16,9" Click="SaveProfile_Click" Content="Check settings and save" Visibility="Collapsed" />
                <Button x:Name="DiscoverButton" Padding="16,9" Click="DiscoverButton_Click" Content="Run discovery" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
