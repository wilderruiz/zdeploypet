<Window x:Class="ZDeployPet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZDeployPet" Height="820" Width="1040" MinHeight="650" MinWidth="860"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="InfoButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,5,8,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Content" Value="i" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="ZDeployPet" />
            <Button x:Name="ForgetSuggestionsButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="12,6" Click="ForgetSuggestions_Click" Content="Forget suggestions" Visibility="Collapsed"
                    ToolTip="Erase remembered input suggestions from this computer. Your saved deployment profile is not deleted." />
        </Grid>
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Margin="0,7,0,18" Foreground="#555"
                   Text="Loading local profile…" />

        <ScrollViewer x:Name="SetupPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,14,0">
                <Border Padding="14" Margin="0,0,0,14" Background="#FFF5E6" BorderBrush="#E6C77A" BorderThickness="1">
                    <TextBlock TextWrapping="Wrap" Text="Set up your deployment profile. ZDeployPet will check and save these settings only on this computer. It will not connect to your servers, ask for passwords or deploy anything yet." />
                </Border>

                <Grid Margin="0,0,0,12">
                <GroupBox Header="1 — Choose the project you want to deploy" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Profile name" />
                        <ComboBox x:Name="ProfileNameTextBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,4" Padding="7" IsEditable="True"
                                  SelectionChanged="ProfileNameTextBox_SelectionChanged" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Project folder" />
                        <ComboBox x:Name="ProjectPathTextBox" Grid.Row="1" Grid.Column="1" Margin="8,4" Padding="7" IsEditable="True" />
                        <Button Grid.Row="1" Grid.Column="2" Margin="4" Padding="14,7" Click="BrowseProject_Click" Content="Browse…" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Linux environment (WSL)" />
                        <ComboBox x:Name="DistributionComboBox" Grid.Row="2" Grid.Column="1" Margin="8,4" Padding="5" IsEditable="False" />
                        <Button Grid.Row="2" Grid.Column="2" Margin="4" Padding="14,7" Click="RefreshDistributions_Click" Content="Refresh" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Project path in WSL" />
                        <TextBox x:Name="WslPathTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,4" Padding="7" IsReadOnly="True" />
                    </Grid>
                </GroupBox>
                <Button Style="{StaticResource InfoButtonStyle}" ToolTip="Identify this deployment profile, select the project folder on Windows, and choose the WSL Linux environment that can access it. ZDeployPet checks the matching Linux path so the deployment script can run from the correct project later." />
                </Grid>

                <Grid Margin="0,0,0,12">
                <GroupBox Header="2 — Choose the deployment script and safety settings" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Deployment script" />
                        <ComboBox x:Name="ScriptPathTextBox" Grid.Column="1" Margin="8,4" Padding="7" IsEditable="True" ToolTip="Example: deploy.sh or scripts/deploy.sh" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Deployment report folder (optional)" />
                        <ComboBox x:Name="ReportRootTextBox" Grid.Row="1" Grid.Column="1" Margin="8,4" Padding="7" IsEditable="True" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Phrase required to deploy" />
                        <ComboBox x:Name="ConfirmationTextBox" Grid.Row="2" Grid.Column="1" Margin="8,4" Padding="7" IsEditable="True" Text="DEPLOY" />
                    </Grid>
                </GroupBox>
                <Button Style="{StaticResource InfoButtonStyle}" ToolTip="Choose the existing deployment script inside your project, where its deployment reports are stored, and the exact phrase required before a live deployment. These settings help ZDeployPet run only the approved script and prevent accidental deployments." />
                </Grid>

                <Grid Margin="0,0,0,12">
                <GroupBox Header="3 — Add the servers that receive your files" Padding="12">
                    <DataGrid x:Name="TargetsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="160"
                              PreviewKeyDown="TargetsGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Server name" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.TargetLabels, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Hostname or IP address" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.Hosts, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SSH port" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.Ports, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Username" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.Users, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
                <Button Style="{StaticResource InfoButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="500">
                                <TextBlock FontWeight="Bold" Text="Define the servers used by this deployment." />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="Add one row for each server ZDeployPet may send files to. Enter a friendly server name, hostname or IP address, SSH port, and username." />
                                <TextBlock Margin="0,9,0,0" FontWeight="Bold" Text="Example" />
                                <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Text="A website may be hosted on one shared-hosting server while a backend service runs on a separate VPS. Add both servers here, then use Section 4 to decide which project parts go to each one." />
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Text="This section only describes connection destinations. It does not connect to a server, sign in, or store passwords." />
                                <TextBlock Margin="0,9,0,0" Foreground="#555" TextWrapping="Wrap" Text="Tip: press Enter while editing a row to add another server row quickly." />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                </Grid>

                <Grid Margin="0,0,0,12">
                <GroupBox Header="4 — Choose where each part of the project goes" Padding="12">
                    <StackPanel>
                        <TextBlock Margin="4,0,4,9" TextWrapping="Wrap" Text="Add one row for every project part that needs its own production destination. The server name must match a server entered above." />
                        <DataGrid x:Name="DestinationsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="160"
                                  PreviewKeyDown="DestinationsGrid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Server name" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding TargetLabel, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.TargetLabels, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="What goes here" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.DestinationLabels, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Destination folder or file" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox IsEditable="True" Text="{Binding RemotePath, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding DataContext.RemotePaths, RelativeSource={RelativeSource AncestorType=Window}}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>
                <Button Style="{StaticResource InfoButtonStyle}">
                    <Button.ToolTip>
                        <ToolTip>
                            <StackPanel MaxWidth="500">
                                <TextBlock FontWeight="Bold" Text="Map your repository layout to your production layout." />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="Your Git repository can keep the whole project together in one folder for simple commits, pull, push, review, and version control even when production requires some files to live in different locations." />
                                <TextBlock Margin="0,9,0,0" FontWeight="Bold" Text="Example repository" />
                                <TextBlock Margin="0,3,0,0" FontFamily="Consolas" Text="website/" />
                                <TextBlock FontFamily="Consolas" Text="private-config.php" />
                                <TextBlock FontFamily="Consolas" Text="backend/" />
                                <TextBlock Margin="0,9,0,0" FontWeight="Bold" Text="Example production mapping" />
                                <TextBlock Margin="0,3,0,0" FontFamily="Consolas" TextWrapping="Wrap" Text="website/ → /home/user/domains/example.com/public_html/" />
                                <TextBlock FontFamily="Consolas" TextWrapping="Wrap" Text="private-config.php → /home/user/domains/example.com/private/private-config.php" />
                                <TextBlock FontFamily="Consolas" TextWrapping="Wrap" Text="backend/ → /opt/example/backend/ on a VPS" />
                                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" Text="The private configuration file can stay above public_html so it is not publicly accessible, while the website remains inside the web root." />
                                <TextBlock Margin="0,9,0,0" FontWeight="Bold" TextWrapping="Wrap" Text="ZDeployPet keeps one clean Git project locally while deploying each part to the correct production server and path." />
                                <TextBlock Margin="0,9,0,0" Foreground="#555" TextWrapping="Wrap" Text="Add one row per distinct destination. Press Enter while editing a row to add the next mapping quickly." />
                            </StackPanel>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>
                </Grid>

                <Grid>
                <GroupBox Header="5 — Check and save your profile" Padding="12">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="Your profile is saved only in your Windows Local Application Data folder and is not added to Git. ZDeployPet never stores passwords, key passphrases or private-key contents in this profile." />
                        <TextBlock x:Name="SetupValidationText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#A02020" />
                    </StackPanel>
                </GroupBox>
                <Button Style="{StaticResource InfoButtonStyle}" ToolTip="Check that all local paths, server details and destination mappings are valid, then save the profile on this computer. Saving does not contact a server or deploy anything, and no passwords or private keys are stored in the profile." />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="DiscoveryPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Padding="12" Margin="0,0,0,12" Background="#EEF6FF" BorderBrush="#AACCE8" BorderThickness="1">
                <TextBlock x:Name="ProfileSummaryText" TextWrapping="Wrap" />
            </Border>
            <TextBox x:Name="ResultsTextBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" Padding="14"
                     Text="Discovery has not run." />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="AccessOnboardingButton" Margin="0,0,8,0" Padding="16,9" Click="AccessOnboarding_Click" Content="Deployment access…" Visibility="Collapsed" />
                <Button x:Name="EditProfileButton" Margin="0,0,8,0" Padding="16,9" Click="EditProfile_Click" Content="Edit profile" Visibility="Collapsed" />
                <Button x:Name="SaveProfileButton" Padding="16,9" Click="SaveProfile_Click" Content="Check settings and save" Visibility="Collapsed" />
                <Button x:Name="DiscoverButton" Padding="16,9" Click="DiscoverButton_Click" Content="Run discovery" Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
