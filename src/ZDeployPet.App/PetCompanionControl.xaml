<UserControl x:Class="ZDeployPet.App.PetCompanionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="198" MaxWidth="300"
             Focusable="False"
             IsTabStop="False">
    <Button x:Name="ActionButton"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            FocusVisualStyle="{x:Null}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Cursor="Hand"
            AutomationProperties.Name="ZDeploy Pet deployment access"
            AutomationProperties.HelpText="Turn deployment access on or off using the existing bounded ZDeployPet session flow.">
        <Border x:Name="ShellBorder"
                Padding="11,8,13,8"
                Background="{DynamicResource AppSurfaceRaisedBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="FacePlate"
                        Width="48" Height="48"
                        Margin="0,0,11,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid x:Name="FaceHost"
                          Width="44" Height="44"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Polygon x:Name="LeftEar"
                                 Points="5,13 11,2 17,14"
                                 Fill="{DynamicResource AppSurfaceBrush}"
                                 Stroke="{DynamicResource AppBorderBrush}"
                                 StrokeThickness="1.1" />
                        <Polygon x:Name="RightEar"
                                 Points="27,14 33,2 39,13"
                                 Fill="{DynamicResource AppSurfaceBrush}"
                                 Stroke="{DynamicResource AppBorderBrush}"
                                 StrokeThickness="1.1" />

                        <Border x:Name="FaceBorder"
                                Width="34" Height="30"
                                Margin="5,10,5,2"
                                CornerRadius="13"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1.1">
                            <Grid>
                                <TextBlock x:Name="EyesText"
                                           Text="•   •"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource AppTextBrush}" />
                                <TextBlock x:Name="MouthText"
                                           Text="ᴥ"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,3"
                                           Foreground="{DynamicResource AppTextBrush}" />
                            </Grid>
                        </Border>

                        <Ellipse x:Name="StatusDot"
                                 Width="9" Height="9"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,1,1"
                                 Stroke="{DynamicResource AppBackgroundBrush}"
                                 StrokeThickness="1.4" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="ZDeploy Pet"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock x:Name="StateText"
                               Text="LOCKED"
                               FontSize="11.5"
                               FontWeight="Bold"
                               Margin="0,1,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                    <TextBlock x:Name="MessageText"
                               Text="Deployment access is off."
                               FontSize="10.25"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppMutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Button>
</UserControl>
